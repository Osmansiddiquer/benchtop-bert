# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments / secrets
.venv/
venv/
env/
.env
.env.*

# Editors / tooling
.vscode/
.claude/

# Large training artifacts -----------------------------------------------
# Model weights: ~110-345 MB each, 9 of them.
*.pt
# Packed token memmaps (~6 GB) and their raw parquet downloads. The leading slash
# anchors these to the repo root -- an unanchored `data/` also matches
# mini_enc_transformer/data/ and would silently drop the package's data layer.
/data/
*.bin
# HF datasets materialised on disk.
/datasets/
# Run logs and the pre-refactor code snapshot.
# Ignore the CONTENTS, not the directory: git does not descend into an excluded
# directory, so a negation inside `/logs/` could never re-include anything.
/logs/*
# ...except the diagnostic time-series. These are ~215 KB total and are the evidence
# behind the report's tables (ablation cost, FFN slack, attention health per step).
# They cannot be regenerated without re-running the training they were measured during.
!/logs/*.jsonl

# checkpoints/ is NOT ignored wholesale: the *.pt rule above drops the weights
# while keeping each run's metrics.jsonl, which is the training history and only
# a few hundred KB.

# LaTeX build artifacts. report.pdf IS committed -- it is a deliverable, and the
# reader should not need a TeX toolchain to read the report.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.xdv
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
